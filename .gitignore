# 用户数据与本地配置整体忽略;用 data/* 而非 data/ —— git 不会下探已忽略目录,
# 负向规则(!data/.htaccess)只有在目录本身未被整目录忽略时才生效
data/*
!data/.htaccess
!data/.gitkeep
# 本地起测试实例时用的独立数据目录(data-8999 等,见 README 的本地测试写法):
# 里面是 sqlite 库、cookie jar 与网页缓存,属于运行期数据,不入库
data-*/
config.php
*.log
.tmp/
.zcode/
.zcodeignore
node_modules/
gui-test-screenshots/
nul
